ANM_ENV=development
ANM_LOG_LEVEL=INFO
ANM_AUTH_MODE=local
ANM_LOCAL_PRINCIPAL=local-admin
ANM_DATABASE_URL=postgresql+psycopg://anm:anm@postgres:5432/anm
ANM_NATS_URL=nats://nats:4222
ANM_OPA_URL=http://opa:8181
ANM_OPENBAO_URL=http://openbao:8200
ANM_OPENBAO_TOKEN_FILE=/run/secrets/openbao_token
ANM_UI_ORIGIN=http://localhost:8080
ANM_SCHEMA_ROOT=schemas
ANM_AUTONOMY_LEVEL=2
ANM_EXECUTION_STALE_SECONDS=300
ANM_AI_ENABLED=false
ANM_MODEL_RELAY_URL=http://model-relay:8090
ANM_MODEL_TIMEOUT_SECONDS=45
ANM_AI_MAX_EVIDENCE_EVENTS=50
ANM_AI_MAX_CONTEXT_CHARS=40000
ANM_AI_LOCAL_PROVIDER_HOSTS=ollama,litellm
