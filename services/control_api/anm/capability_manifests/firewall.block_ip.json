{
  "id": "firewall.block_ip",
  "version": "1.0.0",
  "description": "Block one explicitly supplied IP address using the reviewed reference firewall adapter.",
  "risk": 2,
  "write": true,
  "reversible": true,
  "lifecycle": "ENABLED",
  "parameters_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["address"],
    "properties": {
      "address": {
        "oneOf": [
          {"type": "string", "format": "ipv4"},
          {"type": "string", "format": "ipv6"}
        ]
      },
      "reason_code": {
        "type": "string",
        "enum": ["known_malicious", "incident_containment", "operator_request"]
      },
      "duration_minutes": {
        "type": "integer",
        "minimum": 5,
        "maximum": 1440
      }
    }
  },
  "execution": {
    "adapter": "reference_firewall",
    "implementation": "executors/reference_adapters.py"
  },
  "verification": {
    "strategy": "reference_firewall_observer",
    "timeout_seconds": 180
  },
  "rollback": {"capability": "firewall.unblock_ip", "version": "1.0.0"},
  "artifacts": [
    "executors/reference_adapters.py",
    "services/verification.py"
  ]
}
