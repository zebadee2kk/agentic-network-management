{
  "id": "endpoint.unisolate",
  "version": "1.0.0",
  "description": "Remove ANM-managed endpoint isolation through the reviewed endpoint-control adapter.",
  "risk": 2,
  "write": true,
  "reversible": false,
  "lifecycle": "ENABLED",
  "parameters_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "reason_code": {
        "type": "string",
        "enum": ["rollback", "operator_request", "incident_resolved"]
      }
    }
  },
  "execution": {
    "adapter": "reference_endpoint",
    "implementation": "executors/reference_adapters.py"
  },
  "verification": {
    "strategy": "reference_endpoint_observer",
    "timeout_seconds": 180
  },
  "rollback": null,
  "artifacts": [
    "executors/reference_adapters.py",
    "services/verification.py"
  ]
}
