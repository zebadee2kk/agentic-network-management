{
  "id": "firewall.unblock_ip",
  "version": "1.0.0",
  "description": "Remove one ANM-managed IP block using the reviewed reference firewall adapter.",
  "risk": 2,
  "write": true,
  "reversible": false,
  "lifecycle": "ENABLED",
  "parameters_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["address"],
    "properties": {
      "address": {
        "oneOf": [
          {"type": "string", "format": "ipv4"},
          {"type": "string", "format": "ipv6"}
        ]
      },
      "reason_code": {
        "type": "string",
        "enum": ["rollback", "operator_request", "incident_resolved"]
      }
    }
  },
  "execution": {
    "adapter": "reference_firewall",
    "implementation": "executors/reference_adapters.py"
  },
  "verification": {
    "strategy": "reference_firewall_observer",
    "timeout_seconds": 180
  },
  "rollback": null,
  "artifacts": [
    "executors/reference_adapters.py",
    "services/verification.py"
  ]
}
