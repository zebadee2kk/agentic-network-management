{
  "id": "linux.restart_service",
  "version": "1.0.0",
  "description": "Restart a specifically named approved Linux service on one managed asset.",
  "risk": 2,
  "write": true,
  "reversible": false,
  "lifecycle": "ENABLED",
  "parameters_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["service_name"],
    "properties": {
      "service_name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9_.@-]+$"
      }
    }
  },
  "execution": {
    "adapter": "ansible_linux",
    "implementation": "execution_artifacts/linux_restart_service.yml"
  },
  "verification": {"strategy": "binding_probe", "timeout_seconds": 120},
  "rollback": null,
  "artifacts": [
    "executors/ansible_adapter.py",
    "execution_artifacts/linux_restart_service.yml",
    "services/verification.py"
  ]
}
