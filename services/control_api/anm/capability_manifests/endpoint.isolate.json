{
  "id": "endpoint.isolate",
  "version": "1.0.0",
  "description": "Isolate a standard managed endpoint from normal network communication using a reviewed endpoint-control adapter.",
  "risk": 2,
  "write": true,
  "reversible": true,
  "lifecycle": "ENABLED",
  "parameters_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "reason_code": {
        "type": "string",
        "enum": ["suspected_compromise", "malware_containment", "operator_request"]
      },
      "duration_minutes": {
        "type": "integer",
        "minimum": 5,
        "maximum": 1440
      }
    }
  },
  "execution": {"adapter": "reserved_phase6", "implementation": "capability:endpoint.isolate"},
  "verification": {"strategy": "endpoint_isolation_state_and_traffic", "timeout_seconds": 180},
  "rollback": {"capability": "endpoint.unisolate", "version": "1.0.0"}
}
