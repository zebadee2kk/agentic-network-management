{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-network-management.local/schemas/event-envelope.schema.json",
  "title": "Canonical Event Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "schema_version",
    "occurred_at",
    "ingested_at",
    "source",
    "type",
    "severity",
    "confidence",
    "summary",
    "trust"
  ],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "schema_version": { "type": "string", "const": "1.0.0" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "ingested_at": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["connector", "instance"],
      "properties": {
        "connector": { "type": "string", "minLength": 1, "maxLength": 64 },
        "instance": { "type": "string", "minLength": 1, "maxLength": 128 },
        "source_event_id": { "type": ["string", "null"], "maxLength": 256 }
      }
    },
    "type": { "type": "string", "pattern": "^[a-z0-9_.-]{1,128}$" },
    "severity": { "type": "integer", "minimum": 0, "maximum": 10 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "asset_id": { "type": ["string", "null"], "format": "uuid" },
    "site_id": { "type": ["string", "null"], "format": "uuid" },
    "classifications": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "maxLength": 128 }
    },
    "summary": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "raw_reference": { "type": ["string", "null"], "maxLength": 2048 },
    "attributes": {
      "type": "object",
      "maxProperties": 128,
      "additionalProperties": true
    },
    "trust": { "type": "string", "const": "untrusted_evidence" },
    "correlation_id": { "type": ["string", "null"], "format": "uuid" },
    "causation_id": { "type": ["string", "null"], "format": "uuid" }
  }
}
