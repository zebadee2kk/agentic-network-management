{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-network-management.local/schemas/asset.schema.json",
  "title": "Canonical Asset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "schema_version",
    "display_name",
    "asset_type",
    "criticality",
    "status",
    "identifiers"
  ],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "schema_version": { "type": "string", "const": "1.0.0" },
    "display_name": { "type": "string", "minLength": 1, "maxLength": 256 },
    "asset_type": {
      "type": "string",
      "enum": [
        "endpoint",
        "server",
        "network_device",
        "firewall",
        "router",
        "switch",
        "wireless_ap",
        "hypervisor",
        "virtual_machine",
        "iot",
        "printer",
        "service",
        "unknown"
      ]
    },
    "criticality": {
      "type": "string",
      "enum": ["low", "standard", "high", "critical"]
    },
    "status": {
      "type": "string",
      "enum": ["active", "inactive", "retired", "unknown"]
    },
    "site_id": { "type": ["string", "null"], "format": "uuid" },
    "network_zone": { "type": ["string", "null"], "maxLength": 128 },
    "protected_roles": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 32,
      "items": {
        "type": "string",
        "enum": [
          "identity",
          "backup",
          "core_network",
          "security_control",
          "platform_control",
          "hypervisor",
          "critical_application"
        ]
      }
    },
    "identifiers": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["namespace", "value", "confidence"],
        "properties": {
          "namespace": { "type": "string", "minLength": 1, "maxLength": 128 },
          "value": { "type": "string", "minLength": 1, "maxLength": 512 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "first_seen": { "type": ["string", "null"], "format": "date-time" },
          "last_seen": { "type": ["string", "null"], "format": "date-time" }
        }
      }
    },
    "created_at": { "type": ["string", "null"], "format": "date-time" },
    "updated_at": { "type": ["string", "null"], "format": "date-time" }
  }
}
