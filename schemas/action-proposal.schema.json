{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-network-management.local/schemas/action-proposal.schema.json",
  "title": "Action Proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proposal_id",
    "schema_version",
    "capability",
    "capability_version",
    "target_asset_id",
    "parameters",
    "reason",
    "incident_id",
    "evidence_ids",
    "confidence",
    "requested_by"
  ],
  "properties": {
    "proposal_id": { "type": "string", "format": "uuid" },
    "schema_version": { "type": "string", "const": "1.0.0" },
    "capability": { "type": "string", "pattern": "^[a-z0-9_.-]{1,128}$" },
    "capability_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "target_asset_id": { "type": "string", "format": "uuid" },
    "parameters": { "type": "object", "maxProperties": 64, "additionalProperties": true },
    "reason": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "incident_id": { "type": "string", "format": "uuid" },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "type": "string", "format": "uuid" }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "requested_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "type": "string", "enum": ["user", "agent", "system"] },
        "id": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
